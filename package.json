{
  "name": "rinn7e-website",
  "private": true,
  "version": "1.0.0",
  "description": "rinn7e.com: the open source products of rinn7e",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node tool/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "blog:import": "node tool/run.ts tool/import-dev-to.ts"
  },
  "dependencies": {
    "@rinn7e/fp-ts-routing": "github:rinn7e/fp-ts-routing#0d9ec901639572171d6ada5b75aeee6ff945dc43",
    "fp-ts": "^2.16.0",
    "io-ts": "^2.2.21",
    "lucide-react": "^1.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-tea-cup": "5.1.3",
    "tea-cup-fp": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-dom": "^1.52.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^1.52.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.2.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "satori": "0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^8.0.14",
